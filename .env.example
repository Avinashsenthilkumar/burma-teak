# ---------------------------------------------------------------------------
# Burma Teak Plant — environment configuration
# Copy to `.env.local` and fill in. Never commit the filled file.
# ---------------------------------------------------------------------------

# Public site URL, used for canonical tags, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://burmateakplant.com

# --- Enquiry form delivery -------------------------------------------------
# The /api/enquiry route stays inert until ONE of these is configured.
# Until then the form reports honestly that enquiries are not yet being
# delivered and shows the phone/WhatsApp fallback instead.

# Option A — Resend (https://resend.com). Simplest to set up.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=

# Option B — SMTP (any provider, including Bluehost/Gmail/Zoho).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Option C — forward the enquiry to an external CRM/webhook endpoint.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=

# --- Optional integrations -------------------------------------------------
# Google Maps embed. Without it the contact page renders a static location card.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# Analytics (leave blank to disable entirely).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
